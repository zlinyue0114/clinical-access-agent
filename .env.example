# Live runs only. Offline tests and CI do not need these.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
CAA_MODEL=gemini-3.8-flash
CAA_GATEWAY_URL=http://127.0.0.1:8100

# EHR gateway (defaults shown; see src/clinical_access_agent/gateway/config.py)
CAA_FHIR_BASE=http://127.0.0.1:8090/fhir
CAA_TOKEN_PUBLIC_KEY_FILE=.secrets/issuer_ed25519.pub.pem
CAA_PSEUDONYM_KEY_FILE=.secrets/pseudonym.key
CAA_AUDIT_PATH=audit/gateway.jsonl
CAA_WORKLIST_PATH=audit/worklist.jsonl
CAA_MAX_REQUESTS_PER_MINUTE=300
CAA_MAX_PATIENTS_PER_HOUR=60
